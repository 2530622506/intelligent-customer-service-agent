# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/customer_service

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# RustFS / S3-compatible object storage
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=customer-service

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# DashScope chat / embedding / reranker
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen3.7-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com
RERANK_API_KEY=

# MinerU Cloud
MINERU_API_KEY=
MINERU_BASE_URL=

# Langfuse Cloud
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Evaluation
EVAL_JUDGE_MODEL=qwen3.7-flash
EVAL_CONCURRENCY=2
EVAL_FILTER=
EVAL_USER_ID=eval-admin
